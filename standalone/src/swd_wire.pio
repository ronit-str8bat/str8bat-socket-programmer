; Each command is count-1 (bits 0..4), read flag (bit 5).
; CPU changes SWDIO direction only after receiving completion, with SWCLK low.
; Four PIO cycles per bit. Capture at the rising edge BEFORE target output
; propagation, matching Raspberry Pi debugprobe's PIO receive sequence.
.program swd_wire
.side_set 1
.wrap_target
command:
    pull block          side 0
    out x, 5            side 0
    out y, 1            side 0
    jmp !y write_start  side 0
    mov isr, null       side 0
read_loop:
    in pins, 1          side 1 [1]
    jmp x-- read_loop   side 0 [1]
    push block          side 0
    jmp command         side 0
write_start:
    pull block          side 0
write_loop:
    out pins, 1         side 0 [1]
    jmp x-- write_loop  side 1 [1]
    mov isr, null       side 0
    push block          side 0
.wrap
